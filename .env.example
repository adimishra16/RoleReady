# Copy to .env.local and fill in real values. Never commit .env.local.

# AI — Nebius Token Factory (https://tokenfactory.nebius.com/project/api-keys)
NEBIUS_API_KEY=
NEBIUS_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# Database — Neon (https://console.neon.tech)
DATABASE_URL=

# Auth — Clerk (https://dashboard.clerk.com → API Keys)
# Email only: Dashboard → User & authentication → Email, Phone, Username
# → turn OFF Phone number (keep Email on). App UI also hides phone fields.
# On sign-in, the app upserts the Clerk user into Neon `users` automatically.
# Optional webhook backup: Dashboard → Webhooks → https://YOUR_HOST/api/webhooks/clerk
# Events: user.created, user.updated, user.deleted
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional AI usage defaults (applied when creating/reading limits)
AI_REWRITE_DEFAULT_LIMIT=15
AI_OTHER_DEFAULT_LIMIT=10

# Optional
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
BLOB_READ_WRITE_TOKEN=
