# Copy to .env.local and fill in real values. Never commit .env.local.

# AI — Nebius Token Factory (https://tokenfactory.nebius.com/project/api-keys)
# Create an API key in the console. An invalid key makes AI streams return empty/error.
# Leave blank to use the local mock stream for development.
NEBIUS_API_KEY=
NEBIUS_MODEL=deepseek-ai/DeepSeek-V3-0324

# ── Appwrite (Auth + Database) ───────────────────────────────────────────────
# Console: https://cloud.appwrite.io (or your self-hosted endpoint)
# 1) Create a project → Add a Web platform with hostname `localhost`
# 2) Auth → Email/Password → enable
# 3) Overview → Integrations → API keys → scopes needed for RoleReady:
#      users.read, users.write, sessions.write,
#      databases.read, tables.read, tables.write,
#      rows.read, rows.write
#    (This project's `roleready` DB is legacy TablesDB — not DocumentsDB.
#     documentsdb.* scopes alone will not work.)
#    After updating scopes, restart npm run dev.
# 4) Databases → create database + collections matching your migrated data
#
# Attribute names expected (snake_case, same as former Neon columns):
#   users: email, name, role, target_job_title, industry, ai_enabled,
#          ai_rewrite_limit, ai_rewrite_used, ai_other_limit, ai_other_used,
#          plan, subscription_status, razorpay_customer_id, razorpay_subscription_id,
#          subscription_current_period_end, created_at, updated_at
#   Document $id for users = Appwrite Auth user id
#   resumes: user_id, title, template_id, theme_color, font_family, created_at, updated_at
#   resume_sections: resume_id, type, order, content (string JSON), created_at, updated_at
#   shared_links: resume_id, slug, is_public, created_at
#   app_settings: key, value, updated_at
#   billing_events: user_id, event_type, razorpay_event_id, payload (string JSON), created_at
#   job_matches: resume_id, job_description, match_score, missing_keywords, created_at
#
# Admin: set role = "admin" on your users document in Appwrite Console, then open /admin

NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=roleready
APPWRITE_COLLECTION_USERS=users
APPWRITE_COLLECTION_RESUMES=resumes
APPWRITE_COLLECTION_RESUME_SECTIONS=resume_sections
APPWRITE_COLLECTION_JOB_MATCHES=job_matches
APPWRITE_COLLECTION_SHARED_LINKS=shared_links
APPWRITE_COLLECTION_BILLING_EVENTS=billing_events
APPWRITE_COLLECTION_APP_SETTINGS=app_settings

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Billing — Razorpay (India)
# 1) Create account: https://dashboard.razorpay.com
# 2) API Keys → copy Key Id + Secret
# 3) Subscriptions → Plans → create two monthly plans:
#      Starter: ₹59 (5900 paise) · Pro: ₹119 (11900 paise)
# 4) Paste plan ids below. Webhook URL: https://YOUR_HOST/api/webhooks/razorpay
#    Events: subscription.activated, subscription.charged, subscription.cancelled,
#            subscription.halted, subscription.completed, payment.captured
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_STARTER=
RAZORPAY_PLAN_ID_PRO=

# Optional AI usage defaults (applied when creating/reading limits)
AI_REWRITE_DEFAULT_LIMIT=15
AI_OTHER_DEFAULT_LIMIT=10

# Optional
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
BLOB_READ_WRITE_TOKEN=
