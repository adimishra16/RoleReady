# Copy to .env.local and fill in real values. Never commit .env.local.

# AI — Nebius Token Factory (https://tokenfactory.nebius.com/project/api-keys)
NEBIUS_API_KEY=
NEBIUS_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# Database — Neon (https://console.neon.tech)
DATABASE_URL=

# Auth — Clerk (https://dashboard.clerk.com → API Keys)
# Email only: Dashboard → User & authentication → Email, Phone, Username
# → turn OFF Phone number (keep Email on). App UI also hides phone fields.
# On sign-in, the app upserts the Clerk user into Neon `users` automatically.
# Optional webhook backup: Dashboard → Webhooks → https://YOUR_HOST/api/webhooks/clerk
# Events: user.created, user.updated, user.deleted
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional webhook backup (REQUIRED for /api/webhooks/clerk to accept events)
# Dashboard → Webhooks → https://YOUR_HOST/api/webhooks/clerk
# Events: user.created, user.updated, user.deleted
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin: promote yourself in Neon only (never via UI):
#   UPDATE users SET role = 'admin' WHERE email = 'you@example.com';
# Then open /admin to manage AI tokens & global AI switch.

# Billing — Razorpay (India)
# 1) Create account: https://dashboard.razorpay.com
# 2) API Keys → copy Key Id + Secret
# 3) Subscriptions → Plans → create two monthly plans:
#      Starter: ₹59 (5900 paise) · Pro: ₹119 (11900 paise)
# 4) Paste plan ids below. Webhook URL: https://YOUR_HOST/api/webhooks/razorpay
#    Events: subscription.activated, subscription.charged, subscription.cancelled,
#            subscription.halted, subscription.completed, payment.captured
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_STARTER=
RAZORPAY_PLAN_ID_PRO=

# Optional AI usage defaults (applied when creating/reading limits)
AI_REWRITE_DEFAULT_LIMIT=15
AI_OTHER_DEFAULT_LIMIT=10

# Optional
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
BLOB_READ_WRITE_TOKEN=
